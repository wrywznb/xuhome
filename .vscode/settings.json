{
  "files.encoding": "utf8",
  "files.autoGuessEncoding": true,
  "files.eol": "\n",
  "editor.wordWrap": "on",
  "editor.tabSize": 2,
  "editor.renderWhitespace": "boundary",
  "editor.rulers": [100],
  "files.associations": {
    "*.mjs": "javascript"
  },
  "search.exclude": {
    "dist/**": true,
    "docs/*.png": true
  },
  "files.exclude": {
    "**/.edge-tmp": true
  },
  "markdown.preview.breaks": true,
  "explorer.sortOrder": "type"
}
